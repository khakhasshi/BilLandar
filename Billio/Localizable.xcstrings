    "Only a display name, issuer, and up to four digits are saved. Never enter a full card or bank account number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur ein Anzeigename, ein Aussteller und bis zu vier Ziffern gespeichert. Geben Sie niemals eine vollständige Karten- oder Bankkontonummer ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se guardan un nombre para mostrar, un emisor y hasta cuatro dígitos. Nunca ingrese un número completo de tarjeta o cuenta bancaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls le nom d'affichage, l'émetteur et jusqu'à quatre chiffres sont enregistrés. Ne saisissez jamais un numéro de carte ou de compte bancaire complet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示名、発行者、および最大 4 桁の数字のみが保存されます。カード番号や銀行口座番号を完全に入力しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시 이름, 발급자 및 최대 4자리 숫자만 저장됩니다. 전체 카드 번호나 은행 계좌 번호를 입력하지 마십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅保存显示名称、颁发者和最多四位数字。切勿输入完整的卡号或银行帐号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅儲存顯示名稱、發行者和最多四位數字。切勿輸入完整的卡號或銀行帳號。"
          }
        }
      }
    },
    "Only payments marked paid are included" : {
