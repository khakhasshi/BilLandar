    "Store a safe reference such as card issuer and last four digits. Billio never stores full card numbers or credentials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie eine sichere Referenz, z. B. den Kartenaussteller und die letzten vier Ziffern. Billio speichert niemals vollständige Kartennummern oder Zugangsdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacene una referencia segura como el emisor de la tarjeta y los últimos cuatro dígitos. Billio nunca almacena números de tarjetas completos ni credenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez une référence sûre telle que l’émetteur de la carte et les quatre derniers chiffres. Billio ne stocke jamais les numéros de carte complets ou les informations d'identification."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード発行会社や最後の 4 桁などの安全な参照情報を保存します。 Billio は完全なカード番号や認証情報を保存することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드발급사와 마지막 4자리 등 안전한 참조번호를 저장하세요. Billio는 전체 카드 번호나 자격 증명을 저장하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储安全参考信息，例如发卡机构和最后四位数字。 Billio 从不存储完整的卡号或凭据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存安全參考訊息，例如發卡機構和最後四位數字。 Billio 從不儲存完整的卡號或憑證。"
          }
        }
      }
    },
