    "Billio" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビリオ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빌리오"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比利奥"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比利奧"
          }
        }
      }
    },
    "Billio does not process payments and never asks for full card numbers, bank credentials, or security codes. Payment methods contain only labels and optional last-four-digit references." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio verarbeitet keine Zahlungen und fragt niemals nach vollständigen Kartennummern, Bankzugangsdaten oder Sicherheitscodes. Zahlungsmethoden enthalten nur ein Label und optional die letzten vier Ziffern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio no procesa pagos y nunca solicita números de tarjeta completos, credenciales bancarias o códigos de seguridad. Los métodos de pago contienen solo etiquetas y referencias opcionales de los últimos cuatro dígitos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio ne traite pas les paiements et ne demande jamais les numéros de carte complets, les identifiants bancaires ou les codes de sécurité. Les moyens de paiement contiennent uniquement un libellé et, éventuellement, les quatre derniers chiffres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio は支払いを処理せず、カード番号全体や銀行の認証情報、セキュリティコードを尋ねることもありません。支払い方法にはラベルと、任意でカード番号の下4桁だけを保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio는 결제를 처리하지 않으며 전체 카드 번호, 은행 로그인 정보 또는 보안 코드를 요구하지 않습니다. 결제 수단에는 라벨과 선택적인 카드 끝 4자리만 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 不处理付款，也不会要求完整的卡号、银行凭据或安全码。付款方式仅保存标签和可选的卡号末四位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 不處理付款，也不會要求完整的卡號、銀行登入資訊或安全碼。付款方式只會儲存標籤，以及可選的卡號末四碼。"
          }
        }
      }
    },
    "Billio requests current and historical reference rates from Frankfurter. Requests contain currency codes and dates, not your bill names or payment details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio ruft aktuelle und historische Referenzkurse von Frankfurter ab. Die Anfragen enthalten nur Währungscodes und Daten, keine Rechnungsnamen oder Zahlungsdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio obtiene de Frankfurter los tipos de cambio de referencia actuales e históricos. Las solicitudes solo contienen códigos de moneda y fechas, no los nombres de tus facturas ni tus datos de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio obtient auprès de Frankfurter les taux de change de référence actuels et historiques. Les requêtes contiennent uniquement des codes de devise et des dates, jamais les noms de vos factures ni vos informations de paiement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio は Frankfurter から現在と過去の基準レートを取得します。リクエストに含まれるのは通貨コードと日付だけで、請求名や支払い情報は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio는 Frankfurter에서 현재 및 과거 기준 환율을 가져옵니다. 요청에는 통화 코드와 날짜만 포함되며 청구서 이름이나 결제 정보는 포함되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 从 Frankfurter 获取当前和历史参考汇率。请求仅包含货币代码和日期，不会包含你的账单名称或付款信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 從 Frankfurter 取得目前和歷史參考匯率。請求只包含貨幣代碼和日期，不會包含你的帳單名稱或付款資訊。"
          }
        }
      }
    },
    "Billio will record a confirmed payment. You can undo the change immediately afterward." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio erfasst eine bestätigte Zahlung. Sie können diese Änderung direkt im Anschluss rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio registrará un pago confirmado. Puedes deshacer el cambio inmediatamente después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio enregistrera un paiement confirmé. Vous pourrez annuler cette modification immédiatement après."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio は確認済みの支払いを記録します。直後に変更を取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio가 확인된 결제를 기록합니다. 이후 즉시 변경을 되돌릴 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 将记录一笔已确认的付款。之后可以立即撤销这项更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 將記錄一筆已確認的付款。之後可以立即復原這項變更。"
          }
        }
      }
    },
    "Billio will stop including it in upcoming totals and reminders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio nimmt es künftig nicht mehr in Summen und Erinnerungen auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio dejará de incluirlo en los totales y recordatorios futuros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio cessera de l’inclure dans les totaux et rappels à venir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio は今後の合計やリマインダーに含めなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio는 향후 합계와 알림에 해당 항목을 더 이상 포함하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 将不再把它计入后续总额和提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 將不再把它計入後續總額和提醒。"
          }
        }
      }
    },
    "Billio will watch for price changes, trial endings, duplicate services, and payment issues." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio wird auf Preisänderungen, Testabschlüsse, doppelte Dienste und Zahlungsprobleme achten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio estará atento a cambios de precios, finalización de pruebas, servicios duplicados y problemas de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio surveillera les changements de prix, les fins d'essai, les services en double et les problèmes de paiement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio は、価格の変更、トライアルの終了、重複したサービス、支払いの問題を監視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio는 가격 변동, 체험판 종료, 서비스 중복, 결제 문제 등을 지켜볼 것입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 将关注价格变化、试用结束、重复服务和付款问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billio 將專注於價格變化、試用結束、重複服務和付款問題。"
          }
        }
      }
    },
    "Bills" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechnungen"
          }
        },
